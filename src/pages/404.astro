---
import Icon from "@/components/Icon.astro";
import Base from "@/layouts/Base.astro";
import { withBase } from "@/lib/url";
---

<Base title="Nie ma takiej strony" home={false}>
  <section class="wrap grid min-h-[80svh] content-center pt-(--header-h)">
    <p class="eyebrow">Błąd 404</p>
    <h1 class="display h-hero mt-6 max-w-[12ch]">
      Tej strony <span class="serif accent">nie ma</span>
    </h1>
    <p class="lead mt-8 max-w-xl">Adres mógł się zmienić albo strona została przeniesiona.</p>
    <a class="btn mt-10 w-fit" href={withBase("/")}>
      Wróć na stronę główną <Icon name="arrow-right" />
    </a>
  </section>
</Base>
