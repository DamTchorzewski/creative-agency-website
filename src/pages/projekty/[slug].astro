---
import { Image } from "astro:assets";

import Icon from "@/components/Icon.astro";
import RiseText from "@/components/RiseText.astro";
import { categories, projects, type Project } from "@/data/site";
import Base from "@/layouts/Base.astro";
import { neighbours } from "@/lib/projects";
import { withBase } from "@/lib/url";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { next } = neighbours(projects, project.slug);
const category = categories.find((c) => c.id === project.category)?.label ?? "";
const facts = [
  { label: "Klient", value: project.client },
  { label: "Rok", value: String(project.year) },
  { label: "Kategoria", value: category },
  { label: "Zakres", value: project.scope.join(", ") },
];
---

<Base title={project.title} description={project.lead} home={false}>
  <article class="pt-[calc(var(--header-h)+2.5rem)]">
    <div class="wrap">
      <a
        class="link-underline inline-flex items-center gap-2 text-muted"
        href={`${withBase("/")}#realizacje`}
      >
        <Icon name="arrow-left" class="size-4" /> Wszystkie realizacje
      </a>
      <p class="eyebrow mt-10">
        {category} · {project.year}
      </p>
      <h1 class="display h-hero mt-5 max-w-[16ch]">
        <RiseText text={project.title} />
      </h1>
      <p class="lead mt-8 max-w-2xl" data-hero-fade>
        {project.lead}
      </p>

      <div
        class={`panel case-panel vt-panel-${project.slug} mt-12 lg:mt-16`}
        data-tone={project.tone}
      >
        <div class="plate" data-plate>
          <Image
            src={project.image}
            widths={[370, 740]}
            sizes="(min-width: 48rem) 26rem, 55vw"
            alt={project.imageAlt}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <dl class="mt-12 grid gap-8 border-b border-line pb-12 sm:grid-cols-2 lg:grid-cols-4">
        {facts.map((fact) => (
          <div class="border-t border-line pt-4" data-reveal>
            <dt class="text-sm text-muted">{fact.label}</dt>
            <dd class="mt-1 text-lg font-medium">{fact.value}</dd>
          </div>
        ))}
      </dl>

      <div class="grid gap-12 py-16 lg:grid-cols-2 lg:gap-20 lg:py-24">
        <section aria-labelledby="challenge" data-reveal>
          <h2 id="challenge" class="h-card">
            Wyzwanie
          </h2>
          <p class="lead mt-5">{project.challenge}</p>
        </section>
        <section aria-labelledby="solution" data-reveal>
          <h2 id="solution" class="h-card">
            Rozwiązanie
          </h2>
          <p class="lead mt-5">{project.solution}</p>
        </section>
      </div>

      <section aria-labelledby="results" class="pb-20 lg:pb-28">
        <h2 id="results" class="eyebrow">
          Efekty
        </h2>
        <ul class="mt-8 grid gap-x-8 gap-y-10 md:grid-cols-3">
          {project.results.map((result) => (
            <li class="border-t border-line pt-6" data-reveal>
              <p class="stat-value text-[clamp(2.75rem,2rem+3vw,5rem)]">{result.value}</p>
              <p class="mt-3 text-muted">{result.label}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <a
      href={withBase(`/projekty/${next.slug}/`)}
      class="group block border-t border-line py-16 lg:py-24"
      data-cursor="view"
    >
      <span class="wrap block">
        <span class="text-sm text-muted">Następny projekt</span>
        <span class="mt-4 flex items-center justify-between gap-6">
          <span class="display h-section transition-colors duration-500 group-hover:text-accent">
            {next.title}
          </span>
          <span class="icon-btn size-14! flex-none transition-transform duration-500 group-hover:-rotate-45">
            <Icon name="arrow-right" />
          </span>
        </span>
      </span>
    </a>
  </article>
</Base>
