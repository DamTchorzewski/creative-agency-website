---
import { Image } from "astro:assets";

import Icon from "@/components/Icon.astro";
import { categories, type Project } from "@/data/site";
import { withBase } from "@/lib/url";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const category = categories.find((c) => c.id === project.category)?.label ?? "";
---

<li class="work-card" data-category={project.category} data-reveal>
  <a href={withBase(`/projekty/${project.slug}/`)} data-cursor="view">
    <div class={`panel vt-panel-${project.slug}`} data-tone={project.tone}>
      <div class="grid w-full place-items-center" data-parallax>
        <div class="plate" data-plate>
          <Image
            src={project.image}
            widths={[370, 740]}
            sizes="(min-width: 48rem) 23rem, 62vw"
            alt={project.imageAlt}
            loading="lazy"
          />
        </div>
      </div>
    </div>
    <div class="mt-5 flex items-start justify-between gap-4">
      <div>
        <h3 class="text-2xl font-medium tracking-[-0.035em] sm:text-3xl">{project.title}</h3>
        <p class="mt-1 text-muted">
          {category} · {project.year}
        </p>
      </div>
      <span class="arrow" aria-hidden="true">
        <Icon name="arrow-up-right" class="size-5" />
      </span>
    </div>
  </a>
</li>
