---
// Generated art for the service cards (stand-ins until the 3D renders arrive). Colours come from the tokens.
import type { ServiceArt } from "@/data/site";

interface Props {
  art: ServiceArt;
}

const { art } = Astro.props;
---

{art === "code" && (
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g data-art-float>
      <rect
        x="60"
        y="52"
        width="280"
        height="196"
        rx="14"
        fill="var(--bg)"
        stroke="currentColor"
        stroke-opacity=".35"
      />
      <rect x="60" y="52" width="280" height="30" rx="14" fill="currentColor" fill-opacity=".12" />
      <circle cx="80" cy="67" r="4.5" fill="currentColor" />
      <circle cx="95" cy="67" r="4.5" fill="currentColor" fill-opacity=".5" />
      <circle cx="110" cy="67" r="4.5" fill="currentColor" fill-opacity=".25" />
      <g stroke="currentColor" stroke-width="7" stroke-linecap="round">
        <path d="M88 108h70" />
        <path d="M108 128h120" stroke-opacity=".45" />
        <path d="M108 148h84" stroke-opacity=".45" />
        <path d="M128 168h130" stroke-opacity=".25" />
        <path d="M108 188h60" stroke-opacity=".45" />
        <path d="M88 208h40" />
      </g>
      <path
        d="M268 160l-22 22 22 22M300 160l22 22-22 22"
        fill="none"
        stroke="var(--ink)"
        stroke-width="6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </g>
    <circle cx="330" cy="70" r="26" fill="currentColor" data-art-dot />
  </svg>
)}
{art === "mobile" && (
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g data-art-float>
      <rect
        x="112"
        y="40"
        width="108"
        height="220"
        rx="20"
        fill="var(--bg)"
        stroke="currentColor"
        stroke-opacity=".35"
      />
      <rect x="126" y="70" width="80" height="56" rx="10" fill="currentColor" fill-opacity=".85" />
      <rect x="126" y="136" width="80" height="10" rx="5" fill="currentColor" fill-opacity=".35" />
      <rect x="126" y="154" width="56" height="10" rx="5" fill="currentColor" fill-opacity=".2" />
      <rect x="126" y="196" width="80" height="34" rx="17" fill="var(--ink)" />
      <rect x="150" y="50" width="32" height="6" rx="3" fill="currentColor" fill-opacity=".3" />
    </g>
    <g data-art-float-alt>
      <rect
        x="200"
        y="74"
        width="100"
        height="196"
        rx="20"
        fill="var(--bg)"
        stroke="currentColor"
        stroke-opacity=".35"
      />
      <circle cx="250" cy="130" r="26" fill="currentColor" fill-opacity=".2" />
      <circle cx="250" cy="130" r="12" fill="currentColor" />
      <rect x="216" y="176" width="68" height="10" rx="5" fill="currentColor" fill-opacity=".35" />
      <rect x="216" y="194" width="44" height="10" rx="5" fill="currentColor" fill-opacity=".2" />
      <rect x="216" y="226" width="68" height="26" rx="13" fill="currentColor" />
    </g>
  </svg>
)}
{art === "brand" && (
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g data-art-float>
      <circle cx="168" cy="150" r="74" fill="currentColor" fill-opacity=".9" />
      <circle cx="238" cy="150" r="74" fill="var(--ink)" fill-opacity=".9" />
    </g>
    <g data-art-float-alt>
      <rect x="70" y="214" width="46" height="46" rx="10" fill="currentColor" />
      <rect x="124" y="214" width="46" height="46" rx="10" fill="currentColor" fill-opacity=".55" />
      <rect x="178" y="214" width="46" height="46" rx="10" fill="currentColor" fill-opacity=".25" />
      <rect x="232" y="214" width="46" height="46" rx="10" fill="var(--ink)" />
      <rect
        x="286"
        y="214"
        width="46"
        height="46"
        rx="10"
        fill="var(--bg)"
        stroke="currentColor"
        stroke-opacity=".4"
      />
    </g>
    <path
      d="M300 40c20 30 40 40 70 44"
      fill="none"
      stroke="var(--ink)"
      stroke-width="5"
      stroke-linecap="round"
    />
  </svg>
)}
