---
import { stats } from "@/data/site";
import { formatInteger } from "@/lib/format";
---

<section class="section" aria-labelledby="stats-title">
  <div class="wrap">
    <h2 id="stats-title" class="sr-only">
      Nord Studio w liczbach
    </h2>
    <dl class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="flex flex-col-reverse gap-4 border-t border-line pt-6" data-reveal>
          <dt class="max-w-[16ch] text-muted">{stat.label}</dt>
          <dd class="stat-value">
            <span class="sr-only">
              {formatInteger(stat.value)}
              {stat.suffix}
            </span>
            <span aria-hidden="true">
              <span data-count={stat.value}>{formatInteger(stat.value)}</span>
              <span class="text-accent">{stat.suffix}</span>
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
