---
// The order form (the contact section and the dialog share it). There is no backend: forms.ts validates it and shows
// a message that this is a demo site, so nothing is sent anywhere.
import Icon from "@/components/Icon.astro";

interface Props {
  id: string;
}

const { id } = Astro.props;
const f = (name: string) => `${id}-${name}`;
---

<form class="grid gap-5" method="post" novalidate data-form="order" aria-labelledby={`${id}-title`}>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="field">
      <label for={f("name")}>
        Imię <span class="hint">(wymagane)</span>
      </label>
      <input
        class="input"
        id={f("name")}
        name="name"
        autocomplete="name"
        required
        aria-describedby={f("name-error")}
      />
      <p class="error" id={f("name-error")}></p>
    </div>
    <div class="field">
      <label for={f("phone")}>Telefon</label>
      <input
        class="input"
        id={f("phone")}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
      />
    </div>
  </div>
  <div class="field">
    <label for={f("email")}>
      E-mail <span class="hint">(wymagane)</span>
    </label>
    <input
      class="input"
      id={f("email")}
      name="email"
      type="email"
      autocomplete="email"
      required
      aria-describedby={f("email-error")}
    />
    <p class="error" id={f("email-error")}></p>
  </div>
  <div class="field">
    <label for={f("message")}>O projekcie</label>
    <textarea class="input" id={f("message")} name="message" rows="4"></textarea>
  </div>
  <div class="hp" aria-hidden="true">
    <label for={f("website")}>Strona internetowa</label>
    <input id={f("website")} name="website" tabindex="-1" autocomplete="off" />
  </div>
  <div class="field">
    <div class="check">
      <input
        id={f("consent")}
        name="consent"
        type="checkbox"
        required
        aria-describedby={f("consent-error")}
      />
      <label for={f("consent")}>
        Zgadzam się na kontakt w sprawie mojego zapytania. <span class="hint">(wymagane)</span>
      </label>
    </div>
    <p class="error" id={f("consent-error")}></p>
  </div>
  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn" data-magnetic>
      Wyślij zapytanie <Icon name="arrow-right" />
    </button>
  </div>
  <p class="notice" role="status" aria-live="polite" data-form-status></p>
</form>
