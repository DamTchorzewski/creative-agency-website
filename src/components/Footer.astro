---
import Icon from "@/components/Icon.astro";
import { brand, contact, nav, socials } from "@/data/site";
import { withBase } from "@/lib/url";

interface Props {
  home: boolean;
}

const { home } = Astro.props;
const href = (hash: string) => (home ? hash : `${withBase("/")}${hash}`);
const year = new Date().getFullYear();
---

<footer class="overflow-clip border-t border-line pt-16 lg:pt-24" data-footer>
  <div class="wrap">
    <div class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div class="col-span-2 max-w-sm lg:col-span-1">
        <h2 class="text-2xl font-medium tracking-[-0.03em]">Dołącz do nas</h2>
        <p class="mt-2 text-muted">
          Raz w miesiącu: nasze projekty, narzędzia i to, czego się nauczyliśmy.
        </p>
        <form class="mt-6 grid gap-2" method="post" novalidate data-form="newsletter">
          <label for="newsletter-email" class="text-[0.9375rem] font-medium">
            Twój e-mail
          </label>
          <div class="flex gap-2">
            <input
              class="input min-w-0 flex-1"
              id="newsletter-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              aria-describedby="newsletter-email-error"
            />
            <button type="submit" class="btn flex-none px-5!">
              Zapisz się
            </button>
          </div>
          <p class="error" id="newsletter-email-error"></p>
          <p class="notice mt-2" role="status" aria-live="polite" data-form-status></p>
        </form>
      </div>
      <nav aria-label="Stopka">
        <h2 class="text-sm text-muted">Strona</h2>
        <ul class="mt-4 grid gap-2">
          {nav.map((item) => (
            <li>
              <a class="link-underline" href={href(item.href)}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div>
        <h2 class="text-sm text-muted">Kontakt</h2>
        <address class="mt-4 grid gap-2 not-italic">
          <span>{brand.name}</span>
          <span>{contact.street}</span>
          <span>{contact.city}</span>
          <a class="link-underline w-fit" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
          <a class="link-underline w-fit" href={contact.phoneHref}>
            {contact.phone}
          </a>
        </address>
      </div>
      <div>
        <h2 class="text-sm text-muted">Social media</h2>
        <ul class="mt-4 grid gap-2">
          {socials.map((social) => (
            <li>
              <a
                class="link-underline inline-flex items-center gap-1"
                href={social.href}
                rel="noopener"
              >
                {social.label}
                <Icon name="arrow-up-right" class="size-4" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-sm text-muted">
      <p>
        © {year} {brand.name}. Agencja fikcyjna, strona demonstracyjna.
      </p>
      <a class="link-underline inline-flex items-center gap-2 text-ink" href="#main" data-to-top>
        Wróć na górę <Icon name="arrow-up-right" class="size-4 -rotate-45" />
      </a>
    </div>
  </div>
  <p class="footer-mark wrap select-none" aria-hidden="true" data-footer-mark>
    nord<span class="text-accent">.</span>
  </p>
</footer>
