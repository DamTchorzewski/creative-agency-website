---
import ContactForm from "@/components/ContactForm.astro";
import Icon from "@/components/Icon.astro";
---

<dialog id="order" class="modal" aria-labelledby="order-title">
  <div class="p-6 sm:p-10">
    <div class="mb-8 flex items-start justify-between gap-6">
      <div>
        <p class="eyebrow">Zamów usługę</p>
        <h2 id="order-title" class="h-card mt-3">
          Opowiedzcie nam o projekcie
        </h2>
        <p class="mt-3 text-muted">Odpowiemy w ciągu 24 godzin w dni robocze.</p>
      </div>
      <button
        type="button"
        class="icon-btn flex-none"
        data-order-close
        aria-label="Zamknij formularz"
      >
        <Icon name="close" />
      </button>
    </div>
    <ContactForm id="order" />
  </div>
</dialog>
