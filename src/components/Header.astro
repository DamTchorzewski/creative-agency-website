---
import Icon from "@/components/Icon.astro";
import { contact, nav } from "@/data/site";
import { withBase } from "@/lib/url";

interface Props {
  home: boolean;
}

const { home } = Astro.props;
const href = (hash: string) => (home ? hash : `${withBase("/")}${hash}`);
---

<header class="site-header" data-header>
  <div class="wrap flex h-full items-center justify-between gap-6">
    <a href={withBase("/")} class="wordmark text-2xl" aria-label="Nord Studio, strona główna">
      nord<b>.</b>
      <span class="wordmark-sub">studio</span>
    </a>

    <nav aria-label="Główna" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {nav.map((item) => (
          <li>
            <a class="nav-link" href={href(item.href)} data-nav-link>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="icon-btn"
        data-theme-toggle
        aria-label="Przełącz motyw jasny i ciemny"
      >
        <Icon name="moon" class="theme-icon-light" />
        <Icon name="sun" class="theme-icon-dark" />
      </button>
      <button
        type="button"
        class="btn hidden min-h-11! px-5! text-[0.9375rem]! md:inline-flex"
        data-open-order
        data-magnetic
      >
        Zamów usługę
      </button>
      <button
        type="button"
        class="icon-btn lg:hidden"
        data-menu-open
        aria-haspopup="dialog"
        aria-controls="menu"
        aria-label="Otwórz menu"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<dialog id="menu" class="sheet" aria-label="Menu">
  <div class="wrap flex min-h-full flex-col pb-8">
    <div class="flex h-(--header-h) items-center justify-between">
      <p class="wordmark text-2xl" aria-hidden="true">
        nord<b>.</b>
        <span class="wordmark-sub">studio</span>
      </p>
      <button type="button" class="icon-btn" data-menu-close aria-label="Zamknij menu">
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label="Menu na telefonie" class="mt-8 flex-1">
      <ul class="grid gap-1">
        {nav.map((item, i) => (
          <li>
            <a
              href={href(item.href)}
              class="flex items-baseline gap-4 border-b border-line py-4 text-[clamp(2.25rem,9vw,3.5rem)] leading-none font-medium tracking-[-0.045em]"
              data-menu-link
            >
              <span class="num">0{i + 1}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-10 grid gap-3 text-muted">
      <a class="link-underline w-fit text-ink" href={`mailto:${contact.email}`}>
        {contact.email}
      </a>
      <a class="link-underline w-fit text-ink" href={contact.phoneHref}>
        {contact.phone}
      </a>
      <p>
        {contact.street}, {contact.city}
      </p>
    </div>
    <button type="button" class="btn mt-8 w-full" data-open-order data-menu-link>
      Zamów usługę <Icon name="arrow-right" />
    </button>
  </div>
</dialog>
